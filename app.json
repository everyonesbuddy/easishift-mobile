{
  "expo": {
    "name": "WiserShifts Mobile",
    "slug": "wiser-shifts-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "wiser-shifts-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wisershifts.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "WiserShifts uses your photo library so you can choose a profile picture for your staff account, for example when updating your profile image."
      },
      "associatedDomains": [
        "applinks:wisershifts.com",
        "applinks:www.wisershifts.com"
      ]
    },
    "android": {
      "package": "com.wisershifts.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon-1024.png",
        "backgroundImage": "./assets/images/icon-1024.png",
        "monochromeImage": "./assets/images/icon-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wisershifts.com",
              "pathPrefix": "/s/"
            },
            {
              "scheme": "https",
              "host": "www.wisershifts.com",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-72.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WiserShifts checks your location when you clock in or out, if your facility requires being on site."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon-1024.png",
          "color": "#0284c7"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae9136d7-0023-4cea-8bc9-d79925f686be"
      }
    },
    "owner": "wisershifts2026"
  }
}
